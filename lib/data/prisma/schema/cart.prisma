// Módulo cart: carrito server-side por token invitado o comprador.

model Cart {
  id              String    @id @default(uuid())
  storeId         String    @map("store_id")
  channel         String
  token           String    @unique
  customerId      String?   @map("customer_id")
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status          String    @default("active")
  checkoutStep    String    @default("cart") @map("checkout_step")
  shippingAddress Json?     @map("shipping_address")
  billingAddress  Json?     @map("billing_address")
  shippingMethod  Json?     @map("shipping_method")
  paymentMethod   Json?     @map("payment_method")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  expiresAt       DateTime  @map("expires_at")

  lines  CartLine[]
  orders Order[]

  @@index([storeId, channel, customerId, status])
  @@index([expiresAt])
  @@map("carts")
}

model CartLine {
  id                   String         @id @default(uuid())
  cartId               String         @map("cart_id")
  cart                 Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId            String         @map("variant_id")
  variant              ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  productId            String         @map("product_id")
  product              Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  productTitle         String         @map("product_title")
  variantTitle         String         @map("variant_title")
  sku                  String
  quantity             Int
  currencyCode         String         @map("currency_code")
  capturedUnitPrice    Decimal        @map("captured_unit_price") @db.Decimal(12, 2)
  currentUnitPrice     Decimal        @map("current_unit_price") @db.Decimal(12, 2)
  priceChangeConfirmed Boolean        @default(true) @map("price_change_confirmed")
  availableStock       Int            @default(0) @map("available_stock")
  stockLocationId      String         @map("stock_location_id")
  stockValid           Boolean        @default(true) @map("stock_valid")
  warning              String?
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  @@unique([cartId, variantId])
  @@map("cart_lines")
}
