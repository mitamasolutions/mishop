// Módulo catalog: productos, variantes, opciones, taxonomías, precios y SEO.
// Modelo alineado a Medusa v2 (Product → Option → OptionValue → Variant)
// conservando la lógica de negocio de nopCommerce (marca de primera clase,
// precio especial con vigencia). El inventario vive en inventory.prisma y la
// media en media.prisma.

enum ProductStatus {
  draft
  proposed
  published
  rejected
}

/// Producto. Un producto siempre tiene al menos una variante (el "simple"
/// es un producto con una sola variante por defecto).
model Product {
  id           String        @id @default(uuid())
  title        String
  handle       String        @unique
  subtitle     String?
  description  String?
  status       ProductStatus @default(draft)
  thumbnail    String?
  isGiftcard   Boolean       @default(false) @map("is_giftcard")
  discountable Boolean       @default(true)
  taxCategory  String        @default("standard") @map("tax_category")

  // Dimensiones físicas (para envío y POS)
  weight   Float?
  length   Float?
  height   Float?
  width    Float?
  material String?

  // SEO
  metaTitle       String? @map("meta_title")
  metaDescription String? @map("meta_description")

  // Taxonomías de cardinalidad 1
  typeId  String?      @map("type_id")
  type    ProductType? @relation(fields: [typeId], references: [id])
  brandId String?      @map("brand_id")
  brand   Brand?       @relation(fields: [brandId], references: [id])

  externalId String? @map("external_id")
  metadata   Json?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  options        ProductOption[]
  variants       ProductVariant[]
  categories     ProductCategoryProduct[]
  collections    ProductCollection[]      @relation("ProductCollections")
  tags           ProductTag[]             @relation("ProductTags")
  salesChannels  SalesChannel[]           @relation("ProductSalesChannels")
  specifications ProductSpecification[]
  images         ProductImage[]
  cartLines      CartLine[]
  // Relacionados / cross-sell (auto-referencia muchos-a-muchos dirigida)
  relatedFrom    ProductRelation[]        @relation("RelationSource")
  relatedTo      ProductRelation[]        @relation("RelationTarget")

  @@index([brandId])
  @@index([typeId])
  @@map("products")
}

/// Tipo de producto: etiqueta clasificatoria plana. Máx. uno por producto.
model ProductType {
  id        String    @id @default(uuid())
  value     String    @unique
  metadata  Json?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  products Product[]

  @@map("product_types")
}

/// Marca / fabricante (estilo nopCommerce Manufacturer): entidad de primera
/// clase con su propia página y SEO. Máx. una por producto.
model Brand {
  id              String    @id @default(uuid())
  name            String
  handle          String    @unique
  logoUrl         String?   @map("logo_url")
  description     String?
  metaTitle       String?   @map("meta_title")
  metaDescription String?   @map("meta_description")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  products Product[]

  @@map("brands")
}

/// Colección: agrupación plana para marketing. Un producto puede estar en varias.
model ProductCollection {
  id        String    @id @default(uuid())
  title     String
  handle    String    @unique
  metadata  Json?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  products Product[] @relation("ProductCollections")

  @@map("product_collections")
}

/// Etiqueta libre reutilizable, muchos-a-muchos con productos.
model ProductTag {
  id        String    @id @default(uuid())
  value     String    @unique
  metadata  Json?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  products Product[] @relation("ProductTags")

  @@map("product_tags")
}

/// Canal de venta: determina en qué escaparate/tienda es visible un producto.
model SalesChannel {
  id          String    @id @default(uuid())
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  products Product[] @relation("ProductSalesChannels")

  @@map("sales_channels")
}

/// Categoría jerárquica (árbol con materialized path `mpath`). Un producto
/// puede pertenecer a varias categorías.
model ProductCategory {
  id               String            @id @default(uuid())
  name             String
  description      String?
  handle           String            @unique
  mpath            String?
  isActive         Boolean           @default(true) @map("is_active")
  isInternal       Boolean           @default(false) @map("is_internal")
  rank             Int               @default(0)
  parentCategoryId String?           @map("parent_category_id")
  parent           ProductCategory?  @relation("CategoryTree", fields: [parentCategoryId], references: [id])
  children         ProductCategory[] @relation("CategoryTree")
  metaTitle        String?           @map("meta_title")
  metaDescription  String?           @map("meta_description")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  deletedAt        DateTime?         @map("deleted_at")

  products ProductCategoryProduct[]

  @@index([parentCategoryId])
  @@map("product_categories")
}

/// Tabla puente Producto ↔ Categoría.
model ProductCategoryProduct {
  productId  String          @map("product_id")
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId String          @map("category_id")
  category   ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@map("product_category_product")
}

/// Opción de variante (ej. "Talla"). Pertenece a un producto.
model ProductOption {
  id        String    @id @default(uuid())
  title     String
  productId String    @map("product_id")
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  metadata  Json?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  values ProductOptionValue[]

  @@index([productId])
  @@map("product_options")
}

/// Valor de una opción (ej. "M", "Rojo").
model ProductOptionValue {
  id        String        @id @default(uuid())
  value     String
  optionId  String        @map("option_id")
  option    ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  metadata  Json?
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  deletedAt DateTime?     @map("deleted_at")

  variants ProductVariantOption[]

  @@index([optionId])
  @@map("product_option_values")
}

/// Variante: la unidad vendible. Aquí viven SKU, precio, costo y oferta.
model ProductVariant {
  id                String  @id @default(uuid())
  title             String
  sku               String  @unique
  barcode           String?
  ean               String?
  upc               String?
  allowBackorder    Boolean @default(false) @map("allow_backorder")
  manageInventory   Boolean @default(true) @map("manage_inventory")
  lowStockThreshold Int?    @map("low_stock_threshold")
  taxCategory       String? @map("tax_category")

  // Precio base y costo (la moneda activa de la plataforma en esta fase).
  // El esquema multi-moneda completo vive en PriceSet/Price.
  cost         Decimal?  @db.Decimal(12, 2)
  // Oferta puntual por variante (vía híbrida con PriceList para campañas).
  salePrice    Decimal?  @map("sale_price") @db.Decimal(12, 2)
  saleStartsAt DateTime? @map("sale_starts_at")
  saleEndsAt   DateTime? @map("sale_ends_at")

  weight      Float?
  length      Float?
  height      Float?
  width       Float?
  variantRank Int?   @map("variant_rank")

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  metadata  Json?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  options       ProductVariantOption[]
  priceSet      PriceSet?
  images        ProductImage[]
  inventoryLink ProductVariantInventoryItem?
  cartLines     CartLine[]

  @@index([productId])
  @@map("product_variants")
}

/// Tabla puente Variante ↔ Valor de opción (define la combinación).
model ProductVariantOption {
  variantId     String             @map("variant_id")
  variant       ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValueId String             @map("option_value_id")
  optionValue   ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@map("product_variant_option")
}

/// Atributo de especificación (descriptivo y filtrable; NO genera variantes).
model ProductSpecification {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  value     String
  rank      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@map("product_specifications")
}

/// Productos relacionados / cross-sell (auto-referencia dirigida).
enum ProductRelationType {
  related
  cross_sell
}

model ProductRelation {
  id        String              @id @default(uuid())
  sourceId  String              @map("source_id")
  source    Product             @relation("RelationSource", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId  String              @map("target_id")
  target    Product             @relation("RelationTarget", fields: [targetId], references: [id], onDelete: Cascade)
  type      ProductRelationType @default(related)
  createdAt DateTime            @default(now()) @map("created_at")

  @@unique([sourceId, targetId, type])
  @@index([sourceId])
  @@map("product_relations")
}

// ----- Precios (multi-moneda preparado, una moneda activa en esta fase) -----

/// Conjunto de precios de una variante. Agrupa el precio base y los tier prices.
model PriceSet {
  id        String         @id @default(uuid())
  variantId String         @unique @map("variant_id")
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  prices Price[]

  @@map("price_sets")
}

/// Precio individual. Un precio sin minQuantity es el precio base; con
/// minQuantity es un tier price (precio por cantidad). currencyCode permite
/// multi-moneda futura. Puede pertenecer a una lista de precios (campaña).
model Price {
  id           String     @id @default(uuid())
  priceSetId   String     @map("price_set_id")
  priceSet     PriceSet   @relation(fields: [priceSetId], references: [id], onDelete: Cascade)
  currencyCode String     @map("currency_code")
  amount       Decimal    @db.Decimal(12, 2)
  minQuantity  Int?       @map("min_quantity")
  maxQuantity  Int?       @map("max_quantity")
  priceListId  String?    @map("price_list_id")
  priceList    PriceList? @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@index([priceSetId])
  @@index([priceListId])
  @@map("prices")
}

enum PriceListStatus {
  draft
  active
}

enum PriceListType {
  sale
  override
}

/// Lista de precios para campañas: sobreescribe precios durante su vigencia.
model PriceList {
  id          String          @id @default(uuid())
  title       String
  description String?
  status      PriceListStatus @default(draft)
  type        PriceListType   @default(sale)
  startsAt    DateTime?       @map("starts_at")
  endsAt      DateTime?       @map("ends_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  deletedAt   DateTime?       @map("deleted_at")

  prices Price[]

  @@map("price_lists")
}

// ----- SEO -----

/// Redirect 301 generado al cambiar un slug. fromPath es único.
model UrlRedirect {
  id         String   @id @default(uuid())
  fromPath   String   @unique @map("from_path")
  toPath     String   @map("to_path")
  entityType String?  @map("entity_type")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("url_redirects")
}
