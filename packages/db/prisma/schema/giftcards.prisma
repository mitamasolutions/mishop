// Módulo giftcards: emisión, saldo y redenciones idempotentes.

model GiftCard {
  id                 String   @id @default(uuid())
  storeId            String   @map("store_id")
  code               String
  initialBalance     Decimal  @map("initial_balance") @db.Decimal(12, 2)
  balance            Decimal  @db.Decimal(12, 2)
  currencyCode       String   @map("currency_code")
  status             String
  expiresAt          DateTime? @map("expires_at")
  issuedToCustomerId String?  @map("issued_to_customer_id")
  version            Int      @default(0)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  redemptions GiftCardRedemption[]

  @@unique([storeId, code])
  @@index([storeId, status])
  @@map("gift_cards")
}

model GiftCardRedemption {
  id             String   @id @default(uuid())
  storeId        String   @map("store_id")
  giftCardId     String   @map("gift_card_id")
  giftCard       GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  orderId        String   @map("order_id")
  amount         Decimal  @db.Decimal(12, 2)
  idempotencyKey String   @map("idempotency_key")
  result         Json
  reversedAt     DateTime? @map("reversed_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([storeId, idempotencyKey])
  @@index([giftCardId])
  @@index([storeId, orderId])
  @@map("gift_card_redemptions")
}
