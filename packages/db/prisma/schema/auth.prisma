// Módulo auth: usuarios administrativos, credenciales, roles y tokens.
// Las contraseñas viven en una tabla separada con historial (PasswordCredential).

enum UserStatus {
  invited
  active
  locked
  disabled
}

model User {
  id                  String     @id @default(uuid())
  email               String     @unique
  name                String
  status              UserStatus @default(invited)
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  passwordCredentials PasswordCredential[]
  refreshTokens       RefreshToken[]
  storeRoles          UserStoreRole[]
  invitationTokens    InvitationToken[]
  passwordResetTokens PasswordResetToken[]
  activityLogEntries  ActivityLogEntry[]

  @@map("users")
}

/** Historial de contraseñas hasheadas: cada cambio agrega un registro nuevo. */
model PasswordCredential {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hash      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("password_credentials")
  @@index([userId, createdAt])
}

/** Refresh tokens con familia para detección de reuso y revocación en cascada. */
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId  String    @map("family_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("refresh_tokens")
  @@index([familyId])
}

/** Catálogo de roles. Super Admin es is_system=true, no editable ni borrable. */
model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  isSystem    Boolean  @default(false) @map("is_system")
  permissions String[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userStoreRoles UserStoreRole[]

  @@map("roles")
}

/** Asignación usuario↔rol por tienda. storeId = null implica rol global (Super Admin). */
model UserStoreRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId   String?  @map("store_id")
  store     Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  roleId    String   @map("role_id")
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, storeId, roleId])
  @@map("user_store_roles")
}

/** Token de invitación: 72h, de un solo uso. */
model InvitationToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("invitation_tokens")
}

/** Token de recuperación de contraseña: 1h, de un solo uso. */
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("password_reset_tokens")
}
