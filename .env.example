# ─── Base de datos ────────────────────────────────────────────────────────────
# Desarrollo local (Postgres del docker-compose.yml):
DATABASE_URL="postgresql://mitama:mitama@localhost:5432/mitama"
# Producción en Neon (requiere sslmode=require):
# DATABASE_URL="postgresql://usuario:password@ep-xxxx-xxxx.us-east-2.aws.neon.tech/mitama?sslmode=require"

# ─── Auth (JWT) ───────────────────────────────────────────────────────────────
# Genera valores seguros con: openssl rand -base64 32
JWT_SECRET="cambiame-por-un-secreto-seguro"
JWT_REFRESH_SECRET="cambiame-por-otro-secreto-seguro"

# ─── Seed ─────────────────────────────────────────────────────────────────────
# Contraseña inicial del usuario Super Admin (admin@admin.com) creado por
# `yarn db:seed`. Cámbiala después del primer login.
SEED_ADMIN_PASSWORD="cambiame"

# ─── API ──────────────────────────────────────────────────────────────────────
API_PORT=3000
# Origenes permitidos para CORS. Coma-separados, o `*` para abrir todos.
# Si no se define, se permite cualquier origen (solo recomendado en desarrollo).
# CORS_ORIGINS="http://localhost:3001,https://admin.mitama.example"

# Swagger UI en /docs. Por defecto está deshabilitado; actívalo solo en
# desarrollo o con autenticación externa.
# API_DOCS_ENABLED=true

# Opcional: si no se envía X-Store-Id, la API usa esta tienda en modo single-store.
# Si se omite y solo hay una tienda activa/rol de tienda, se resuelve automáticamente.
# DEFAULT_STORE_ID="uuid-de-la-tienda"

# ─── Admin (Next.js) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3000"

# ─── Settings sensibles ───────────────────────────────────────────────────────
# Clave maestra para cifrar settings sensibles, incluidas credenciales de plugins
# de pago por tienda. Opcional en desarrollo/test; obligatoria en producción.
# Si se omite fuera de producción, esos settings se guardan en plano.
# Genera con: openssl rand -base64 32
# SETTINGS_ENCRYPTION_KEY="cambiame-por-un-secreto-de-32-bytes-o-mas"
